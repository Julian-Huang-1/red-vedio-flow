        "models": [{ "id": "default", "label": "Default (CLI config)" }]
      },
      {
        "id": "devin",
        "title": "Devin CLI",
        "vendor": "Cognition",
        "models": [{ "id": "default", "label": "Default (CLI config)" }]
      },
      {
        "id": "kiro",
