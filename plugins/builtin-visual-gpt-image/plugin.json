{
  "id": "builtin.visual-gpt-image",
  "name": "Built-in GPT Image Visual Provider",
  "version": "0.1.0",
  "apiVersion": "1",
  "backend": {
    "runtime": "process",
    "command": "${NODE}",
    "args": ["backend/main.mjs"]
  },
  "activationEvents": ["onStartup"],
  "contributes": {
    "visualProviders": [
      {
        "id": "gpt-image-2",
        "title": "GPT Image 2",
        "vendor": "OpenAI",
        "capabilities": [
          "text-to-image",
          "image-to-image"
        ],
        "optionsSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "title": "生成方式", "enum": ["auto", "generate", "edit"], "enumNames": ["自动", "生成", "编辑"], "default": "auto" },
            "size": { "type": "string", "title": "尺寸", "enum": ["auto", "1024x1024", "1536x1024", "1024x1536"], "default": "auto" },
            "quality": { "type": "string", "title": "质量", "enum": ["auto", "low", "medium", "high"], "default": "auto" },
            "background": { "type": "string", "title": "背景", "enum": ["auto", "opaque", "transparent"], "default": "auto" },
            "outputFormat": { "type": "string", "title": "输出格式", "enum": ["png", "jpeg", "webp"], "default": "png" },
            "outputCompression": { "type": "integer", "title": "压缩质量", "minimum": 0, "maximum": 100, "default": 100, "advanced": true },
            "inputFidelity": { "type": "string", "title": "输入保真度", "enum": ["low", "high"], "default": "low", "advanced": true },
            "moderation": { "type": "string", "title": "内容审核", "enum": ["auto", "low"], "default": "auto", "advanced": true }
          }
        }
      }
    ]
  },
  "secrets": {
    "GPT_IMAGE_API_KEY": "MAASfd018690923149bc890e003129024aee",
    "GPT_IMAGE_API_BASE_URL": "https://maas.devops.rednote.life/hackson/openai"
  }
}
