{
  "id": "builtin.visual-dreamina",
  "name": "Built-in Dreamina Visual Provider",
  "version": "0.1.0",
  "apiVersion": "1",
  "backend": {
    "runtime": "process",
    "command": "${NODE}",
    "args": ["backend/main.mjs"]
  },
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      {
        "id": "dreamina.generate",
        "title": "Generate media with Dreamina",
        "inputSchema": {
          "type": "object",
          "required": ["capability", "prompt"],
          "properties": {
            "capability": {
              "type": "string",
              "enum": [
                "text-to-image",
                "image-to-image",
                "text-to-video",
                "image-to-video",
                "frames-to-video",
                "image-upscale"
              ]
            },
            "prompt": { "type": "string" },
            "inputs": { "type": "array" },
            "options": { "type": "object" }
          }
        }
      }
    ],
    "visualProviders": [
      {
        "id": "dreamina",
        "title": "即梦 Dreamina",
        "vendor": "ByteDance",
        "capabilities": [
          "text-to-image",
          "image-to-image",
          "text-to-video",
          "image-to-video",
          "frames-to-video",
          "image-upscale"
        ]
      }
    ]
  }
}
